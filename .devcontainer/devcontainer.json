{
  "name": "sakuforge",
  "image": "node:26.13.1-bookworm@sha256:b7087bc4d973034b30854b378ba107f9fab622b47514cb7e2592e41b8bab8d49",
  "mounts": [
    "source=sakuforge-node_modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "postCreateCommand": "npm install -g corepack@0.36.0 && corepack enable && corepack pnpm install --frozen-lockfile",
  "forwardPorts": [3000]
}
